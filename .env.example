# Copie para .env.server. Somente o Node carrega esse arquivo.
# Frontend, /api e /ws devem usar o mesmo domínio.
ACCOUNT_BACKEND=local
# Para usar Supabase:
# ACCOUNT_BACKEND=supabase
# SUPABASE_URL=https://bdcsddepofahusokbhlp.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Nunca coloque a service role em variável VITE_.
PORT=3001
MAX_ROOMS=12
DATA_DIR=./data
# Em produção sob HTTPS:
# SECURE_COOKIES=true
# TRUST_PROXY=true
# Ative TRUST_PROXY somente atrás do seu proxy reverso confiável.
# ALLOWED_ORIGINS=https://jogo.seudominio.com
